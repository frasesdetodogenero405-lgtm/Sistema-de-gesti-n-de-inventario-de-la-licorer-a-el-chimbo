{
  "ProxyReverso": {
    "Routes": {
      "rutaSistema": {
        "ClusterId": "sistemaWeb",
        "Match": { "Path": "{**ruta}" }
      }
    },
    "Clusters": {
      "sistemaWeb": {
        "Destinations": {
          "servidorLocal": { "Address": "http://127.0.0.1:5080/" }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
