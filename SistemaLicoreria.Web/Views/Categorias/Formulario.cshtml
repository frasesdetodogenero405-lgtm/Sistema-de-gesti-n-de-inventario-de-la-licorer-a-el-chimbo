@model SistemaLicoreria.Web.Modelos.Categorias_Producto
@{ var editar = Model.id_categoria > 0; ViewData["Title"] = editar ? "Editar categoría" : "Nueva categoría"; ViewData["Seccion"] = "Categorías"; }
<section class="encabezado-pagina"><div><p class="sobre-titulo">CATÁLOGOS</p><h1>@(editar ? "Editar categoría" : "Agregar categoría")</h1><p class="texto-secundario">La categoría estará disponible al registrar productos.</p></div><a asp-action="Lista" class="boton-secundario">Volver a categorías</a></section>
<section class="panel panel-formulario"><form asp-action="@(editar ? "Editar" : "Crear")" asp-route-id="@Model.id_categoria" method="post"><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><input asp-for="id_categoria" type="hidden" /><div class="rejilla-formulario"><div class="campo-formulario campo-completo"><label asp-for="nombre_categoria">Nombre de la categoría</label><input asp-for="nombre_categoria" class="form-control" maxlength="50" autocomplete="off" /><span asp-validation-for="nombre_categoria" class="texto-error"></span></div></div><div class="botones-formulario"><a asp-action="Lista" class="boton-secundario">Cancelar</a><button type="submit" class="boton-principal">@(editar ? "Guardar cambios" : "Registrar categoría")</button></div></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
