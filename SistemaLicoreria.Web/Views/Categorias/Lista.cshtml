@model IReadOnlyList<SistemaLicoreria.Web.Modelos.Categorias_Producto>
@{ ViewData["Title"] = "Categorías"; ViewData["Seccion"] = "Categorías"; }
<section class="encabezado-pagina"><div><p class="sobre-titulo">CATÁLOGOS</p><h1>Categorías de productos</h1><p class="texto-secundario">Clasifica los productos de la licorería.</p></div><a asp-action="Crear" class="boton-principal">＋ Agregar categoría</a></section>
@if (TempData["Mensaje"] is string mensaje) { <div class="alert alert-success">@mensaje</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
<section class="panel panel-tabla"><form asp-action="Lista" method="get" class="barra-busqueda"><label for="busqueda">Buscar categoría</label><input id="busqueda" name="busqueda" value="@ViewData["Busqueda"]" class="form-control" placeholder="Nombre de la categoría" /><button class="boton-secundario" type="submit">Buscar</button><a asp-action="Lista" class="boton-secundario">Limpiar</a></form>
@if (Model.Count == 0) { <div class="estado-vacio"><strong>No hay categorías registradas</strong><small>Agrega una categoría para seleccionarla al crear productos.</small></div> }
else { <div class="tabla-responsiva"><table class="tabla-sistema"><thead><tr><th>Categoría</th><th>Productos asociados</th><th class="texto-derecha">Acciones</th></tr></thead><tbody>@foreach (var categoria in Model) { <tr><td><strong>@categoria.nombre_categoria</strong></td><td>@categoria.Productos.Count</td><td class="texto-derecha"><div class="acciones-tabla"><a asp-action="Editar" asp-route-id="@categoria.id_categoria" class="accion-enlace">Editar</a><form asp-action="Eliminar" asp-route-id="@categoria.id_categoria" method="post" onsubmit="return confirm('¿Eliminar esta categoría?');"><button type="submit" class="accion-enlace accion-eliminar">Eliminar</button></form></div></td></tr> }</tbody></table></div> }</section>
