@model IReadOnlyList<SistemaLicoreria.Web.Modelos.Venta>
@{
    ViewData["Title"] = "Ventas";
    ViewData["Seccion"] = "Ventas";
    var puedeRegistrar = User.IsInRole("Administrador") || User.HasClaim("permiso", "Registrar ventas") || User.HasClaim("permiso", "Gestionar ventas");
}
<section class="encabezado-pagina">
    <div><p class="sobre-titulo">OPERACIONES</p><h1>Ventas</h1><p class="texto-secundario">Consulta el historial y registra nuevas ventas.</p></div>
    @if (puedeRegistrar) { <a asp-action="Crear" class="boton-principal">＋ Registrar venta</a> }
</section>
@if (TempData["Mensaje"] is string mensaje) { <div class="alert alert-success">@mensaje</div> }
<section class="panel panel-tabla">
    <div class="panel-encabezado"><div><h2>Ventas registradas</h2><p>Se muestran las últimas 100 operaciones.</p></div></div>
    @if (Model.Count == 0)
    {
        <div class="estado-vacio"><span>↗</span><strong>Aún no hay ventas</strong>@if (puedeRegistrar) { <small>Usa “Registrar venta” para guardar la primera.</small> }</div>
    }
    else
    {
        <div class="tabla-responsiva"><table class="tabla-sistema">
            <thead><tr><th>Número</th><th>Cliente</th><th>Usuario</th><th>Fecha</th><th>Pago</th><th class="texto-derecha">Total</th></tr></thead>
            <tbody>@foreach (var venta in Model)
            {
                <tr><td><span class="numero-venta">#@venta.id_venta</span></td><td>@venta.id_clienteNavigation.nombre_cliente</td><td>@venta.id_usuarioNavigation.nombre_usuario</td><td>@venta.fecha?.ToString("dd/MM/yyyy HH:mm")</td><td>@venta.metodo_pago</td><td class="texto-derecha"><strong>Bs @venta.total.ToString("N2")</strong></td></tr>
            }</tbody>
        </table></div>
    }
</section>
