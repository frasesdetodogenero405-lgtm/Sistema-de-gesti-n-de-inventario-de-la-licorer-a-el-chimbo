@model SistemaLicoreria.Web.ModelosVista.ProveedorFormularioViewModel
@{
    var editar = Model.id_proveedor > 0;
    ViewData["Title"] = editar ? "Editar proveedor" : "Nuevo proveedor";
    ViewData["Seccion"] = "Proveedores";
}
<section class="encabezado-pagina">
    <div><p class="sobre-titulo">ABASTECIMIENTO</p><h1>@(editar ? "Editar proveedor" : "Agregar proveedor")</h1><p class="texto-secundario">Registra los datos de contacto del proveedor.</p></div>
    <a asp-action="Lista" class="boton-secundario">Volver a proveedores</a>
</section>
<section class="panel panel-formulario">
    <form asp-action="@(editar ? "Editar" : "Crear")" asp-route-id="@Model.id_proveedor" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <input asp-for="id_proveedor" type="hidden" />
        <div class="rejilla-formulario">
            <div class="campo-formulario campo-completo"><label asp-for="nombre_proveedor"></label><input asp-for="nombre_proveedor" class="form-control" autocomplete="organization" /><span asp-validation-for="nombre_proveedor" class="texto-error"></span></div>
            <div class="campo-formulario"><label asp-for="telefono"></label><input asp-for="telefono" class="form-control" autocomplete="tel" /><span asp-validation-for="telefono" class="texto-error"></span></div>
            <div class="campo-formulario"><label asp-for="direccion"></label><input asp-for="direccion" class="form-control" autocomplete="street-address" /><span asp-validation-for="direccion" class="texto-error"></span></div>
        </div>
        <div class="botones-formulario"><a asp-action="Lista" class="boton-secundario">Cancelar</a><button type="submit" class="boton-principal">@(editar ? "Guardar cambios" : "Registrar proveedor")</button></div>
    </form>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
