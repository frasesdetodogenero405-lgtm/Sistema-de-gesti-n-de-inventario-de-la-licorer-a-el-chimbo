@model IReadOnlyList<SistemaLicoreria.Web.Modelos.Proveedor>
@{
    ViewData["Title"] = "Proveedores";
    ViewData["Seccion"] = "Proveedores";
}
<section class="encabezado-pagina">
    <div><p class="sobre-titulo">ABASTECIMIENTO</p><h1>Proveedores</h1><p class="texto-secundario">Administra los contactos que abastecen la licorería.</p></div>
    <a asp-action="Crear" class="boton-principal">＋ Agregar proveedor</a>
</section>
@if (TempData["Mensaje"] is string mensaje) { <div class="alert alert-success">@mensaje</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
<section class="panel panel-tabla">
    <form asp-action="Lista" method="get" class="barra-busqueda">
        <label for="busqueda">Buscar proveedor</label>
        <input id="busqueda" name="busqueda" value="@ViewData["Busqueda"]" class="form-control" placeholder="Nombre del proveedor" />
        <button class="boton-secundario" type="submit">Buscar</button>
        <a asp-action="Lista" class="boton-secundario">Limpiar</a>
    </form>
    @if (Model.Count == 0)
    {
        <div class="estado-vacio"><span>♙</span><strong>No hay proveedores registrados</strong><small>Agrega un proveedor para poder registrar compras.</small></div>
    }
    else
    {
        <div class="tabla-responsiva"><table class="tabla-sistema">
            <thead><tr><th>Proveedor</th><th>Teléfono</th><th>Dirección</th><th class="texto-derecha">Acciones</th></tr></thead>
            <tbody>@foreach (var proveedor in Model)
            {
                <tr><td><strong>@proveedor.nombre_proveedor</strong></td><td>@(proveedor.telefono ?? "—")</td><td>@(proveedor.direccion ?? "—")</td><td class="texto-derecha"><div class="acciones-tabla"><a asp-action="Editar" asp-route-id="@proveedor.id_proveedor" class="accion-enlace">Editar</a><form asp-action="Eliminar" asp-route-id="@proveedor.id_proveedor" method="post" onsubmit="return confirm('¿Eliminar este proveedor?');"><button type="submit" class="accion-enlace accion-eliminar">Eliminar</button></form></div></td></tr>
            }</tbody>
        </table></div>
    }
</section>
