@{
    var sesionIniciada = User.Identity?.IsAuthenticated == true;
    var esAdministrador = User.IsInRole("Administrador");
    var permisosUsuario = User.FindAll("permiso").Select(permiso => permiso.Value)
        .ToHashSet(StringComparer.OrdinalIgnoreCase);
    bool Puede(params string[] acciones) => esAdministrador || acciones.Any(permisosUsuario.Contains);
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Licorería El Chimbo</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(sesionIniciada ? "" : "pagina-acceso")">
    @if (sesionIniciada)
    {
        <div class="marco-aplicacion">
            <aside class="barra-lateral" id="barra-lateral">
                <div class="cabecera-lateral">
                    <a class="marca-sistema" asp-controller="Inicio" asp-action="Tablero">
                        <span class="marca-icono">🍾</span>
                        <span class="texto-marca"><strong>EL CHIMBO</strong><small>Gestión de licorería</small></span>
                    </a>
                    <button class="boton-cerrar-menu" type="button" aria-label="Cerrar menú" title="Cerrar menú">×</button>
                </div>
                <div class="texto-menu">MENÚ PRINCIPAL</div>
                <nav class="navegacion">
                    @if (Puede("Gestionar usuarios")) { <a asp-controller="Inicio" asp-action="Tablero" class="enlace-menu"><span class="icono-enlace">▦</span><span class="texto-enlace">Tablero</span></a> }
                    @if (Puede("Gestionar productos", "consultar productos")) { <a asp-controller="Productos" asp-action="Lista" class="enlace-menu"><span class="icono-enlace">◫</span><span class="texto-enlace">Productos</span></a> }
                    @if (Puede("Gestionar métodos de pago")) { <a asp-controller="MetodosPago" asp-action="Lista" class="enlace-menu"><span class="icono-enlace">$</span><span class="texto-enlace">Métodos de pago</span></a> }
                    @if (Puede("Gestionar marcas")) { <a asp-controller="Marcas" asp-action="Lista" class="enlace-menu"><span class="icono-enlace">🏷</span><span class="texto-enlace">Marcas</span></a> }
                    @if (Puede("Gestionar categorías")) { <a asp-controller="Categorias" asp-action="Lista" class="enlace-menu"><span class="icono-enlace">▤</span><span class="texto-enlace">Categorías</span></a> }
                    @if (Puede("Consultar inventario", "Gestionar inventario")) { <a asp-controller="Inventario" asp-action="Lista" class="enlace-menu"><span class="icono-enlace">▤</span><span class="texto-enlace">Inventario</span></a> }
                    @if (Puede("Consultar clientes", "Gestionar clientes", "Registrar clientes")) { <a asp-controller="Clientes" asp-action="Lista" class="enlace-menu"><span class="icono-enlace">♙</span><span class="texto-enlace">Clientes</span></a> }
                    @if (Puede("Gestionar proveedores")) { <a asp-controller="Proveedores" asp-action="Lista" class="enlace-menu"><span class="icono-enlace">♧</span><span class="texto-enlace">Proveedores</span></a> }
                    @if (Puede("Gestionar ventas", "Registrar ventas")) { <a asp-controller="Ventas" asp-action="Lista" class="enlace-menu"><span class="icono-enlace">↗</span><span class="texto-enlace">Ventas</span></a> }
                    @if (Puede("Gestionar compras")) { <a asp-controller="Compras" asp-action="Lista" class="enlace-menu"><span class="icono-enlace">↙</span><span class="texto-enlace">Compras</span></a> }
                    @if (Puede("Gestionar roles", "Gestionar permisos")) { <a asp-controller="Administracion" asp-action="Roles" class="enlace-menu"><span class="icono-enlace">⚙</span><span class="texto-enlace">Roles y permisos</span></a> }
                </nav>
                <div class="pie-lateral">
                    <div class="texto-pie-lateral">Sistema de gestión<br />Licorería El Chimbo</div>
                    <form asp-controller="Acceso" asp-action="CerrarSesion" method="post">
                        <button type="submit" class="boton-sesion-lateral"><span aria-hidden="true">↪</span> Cerrar sesión</button>
                    </form>
                </div>
            </aside>

            <div class="contenido-aplicacion">
                <header class="barra-superior">
                    <button class="boton-menu-movil" type="button" aria-label="Contraer barra lateral" aria-expanded="true" aria-controls="barra-lateral" title="Contraer o desplegar el menú">☰</button>
                    <div class="ruta-pagina">Sistema <span>/</span> @ViewData["Seccion"]</div>
                    <div class="acciones-cuenta">
                        <span class="estado-cuenta"><span class="punto-conexion"></span> @User.Identity?.Name</span>
                        <form asp-controller="Acceso" asp-action="CerrarSesion" method="post"><button type="submit" class="boton-sesion">Cerrar sesión</button></form>
                    </div>
                </header>
                <main class="contenido-principal">@RenderBody()</main>
                <footer class="pie-pagina">© @DateTime.Now.Year Licorería El Chimbo <span>•</span> Administración de inventario</footer>
            </div>
        </div>
        <div class="fondo-menu"></div>
    }
    else
    {
        <main class="contenido-acceso">@RenderBody()</main>
    }
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/visibilidad-contrasena.js" asp-append-version="true"></script>
    <script src="~/js/menu-lateral.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
