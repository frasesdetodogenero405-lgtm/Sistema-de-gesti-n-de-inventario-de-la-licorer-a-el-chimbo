@model IReadOnlyList<SistemaLicoreria.Web.Modelos.Compra>
@{
    ViewData["Title"] = "Compras";
    ViewData["Seccion"] = "Compras";
}
<section class="encabezado-pagina">
    <div><p class="sobre-titulo">ABASTECIMIENTO</p><h1>Compras</h1><p class="texto-secundario">Consulta las compras y registra la entrada de productos.</p></div>
    <a asp-action="Crear" class="boton-principal">＋ Registrar compra</a>
</section>
@if (TempData["Mensaje"] is string mensaje) { <div class="alert alert-success">@mensaje</div> }
<section class="panel panel-tabla">
    <div class="panel-encabezado"><div><h2>Compras registradas</h2><p>Se muestran las últimas 100 operaciones.</p></div></div>
    @if (Model.Count == 0)
    {
        <div class="estado-vacio"><span>↙</span><strong>Aún no hay compras</strong><small>Usa “Registrar compra” para guardar la primera.</small></div>
    }
    else
    {
        <div class="tabla-responsiva"><table class="tabla-sistema">
            <thead><tr><th>Número</th><th>Proveedor</th><th>Usuario</th><th>Fecha</th><th class="texto-derecha">Total</th></tr></thead>
            <tbody>@foreach (var compra in Model)
            {
                <tr><td><span class="numero-venta">#@compra.id_compra</span></td><td>@compra.id_proveedorNavigation.nombre_proveedor</td><td>@compra.id_usuarioNavigation.nombre_usuario</td><td>@compra.fecha?.ToString("dd/MM/yyyy HH:mm")</td><td class="texto-derecha"><strong>Bs @compra.total.ToString("N2")</strong></td></tr>
            }</tbody>
        </table></div>
    }
</section>
