@model IReadOnlyList<SistemaLicoreria.Web.Modelos.Metodos_Pago>
@{ ViewData["Title"] = "Métodos de pago"; ViewData["Seccion"] = "Métodos de pago"; }
<section class="encabezado-pagina"><div><p class="sobre-titulo">CATÁLOGOS</p><h1>Métodos de pago</h1><p class="texto-secundario">Administra las opciones usadas en ventas y compras.</p></div><a asp-action="Crear" class="boton-principal">＋ Agregar método</a></section>
@if (TempData["Mensaje"] is string mensaje) { <div class="alert alert-success">@mensaje</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
<section class="panel panel-tabla"><form asp-action="Lista" method="get" class="barra-busqueda"><label for="busqueda">Buscar método</label><input id="busqueda" name="busqueda" value="@ViewData["Busqueda"]" class="form-control" placeholder="Nombre del método" /><button class="boton-secundario" type="submit">Buscar</button><a asp-action="Lista" class="boton-secundario">Limpiar</a></form>
@if (Model.Count == 0) { <div class="estado-vacio"><strong>No hay métodos de pago registrados</strong><small>Agrega uno para usarlo en ventas y compras.</small></div> }
else { <div class="tabla-responsiva"><table class="tabla-sistema"><thead><tr><th>Método de pago</th><th>Pagos asociados</th><th class="texto-derecha">Acciones</th></tr></thead><tbody>@foreach (var metodo in Model) { <tr><td><strong>@metodo.nombre_metodo</strong></td><td>@(metodo.Pagos_Compras.Count + metodo.Pagos_Venta.Count)</td><td class="texto-derecha"><div class="acciones-tabla"><a asp-action="Editar" asp-route-id="@metodo.id_metodo" class="accion-enlace">Editar</a><form asp-action="Eliminar" asp-route-id="@metodo.id_metodo" method="post" onsubmit="return confirm('¿Eliminar este método de pago?');"><button type="submit" class="accion-enlace accion-eliminar">Eliminar</button></form></div></td></tr> }</tbody></table></div> }</section>
