@model SistemaLicoreria.Web.Modelos.Metodos_Pago
@{ var editar = Model.id_metodo > 0; ViewData["Title"] = editar ? "Editar método de pago" : "Nuevo método de pago"; ViewData["Seccion"] = "Métodos de pago"; }
<section class="encabezado-pagina"><div><p class="sobre-titulo">CATÁLOGOS</p><h1>@(editar ? "Editar método" : "Agregar método")</h1><p class="texto-secundario">Este catálogo se usa al registrar pagos.</p></div><a asp-action="Lista" class="boton-secundario">Volver a métodos</a></section>
<section class="panel panel-formulario"><form asp-action="@(editar ? "Editar" : "Crear")" asp-route-id="@Model.id_metodo" method="post"><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><input asp-for="id_metodo" type="hidden" /><div class="rejilla-formulario"><div class="campo-formulario campo-completo"><label asp-for="nombre_metodo">Nombre del método</label><input asp-for="nombre_metodo" class="form-control" maxlength="50" autocomplete="off" /><span asp-validation-for="nombre_metodo" class="texto-error"></span></div></div><div class="botones-formulario"><a asp-action="Lista" class="boton-secundario">Cancelar</a><button type="submit" class="boton-principal">@(editar ? "Guardar cambios" : "Registrar método")</button></div></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
