@model SistemaLicoreria.Web.Modelos.Marca
@{ var editar = Model.id_marca > 0; ViewData["Title"] = editar ? "Editar marca" : "Nueva marca"; ViewData["Seccion"] = "Marcas"; }
<section class="encabezado-pagina"><div><p class="sobre-titulo">CATÁLOGOS</p><h1>@(editar ? "Editar marca" : "Agregar marca")</h1><p class="texto-secundario">El nombre estará disponible en el formulario de productos.</p></div><a asp-action="Lista" class="boton-secundario">Volver a marcas</a></section>
<section class="panel panel-formulario"><form asp-action="@(editar ? "Editar" : "Crear")" asp-route-id="@Model.id_marca" method="post"><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><input asp-for="id_marca" type="hidden" /><div class="rejilla-formulario"><div class="campo-formulario campo-completo"><label asp-for="nombre_marca">Nombre de la marca</label><input asp-for="nombre_marca" class="form-control" maxlength="50" autocomplete="off" /><span asp-validation-for="nombre_marca" class="texto-error"></span></div></div><div class="botones-formulario"><a asp-action="Lista" class="boton-secundario">Cancelar</a><button type="submit" class="boton-principal">@(editar ? "Guardar cambios" : "Registrar marca")</button></div></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
