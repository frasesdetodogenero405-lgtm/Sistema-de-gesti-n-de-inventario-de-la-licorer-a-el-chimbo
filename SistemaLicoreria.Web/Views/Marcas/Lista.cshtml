@model IReadOnlyList<SistemaLicoreria.Web.Modelos.Marca>
@{ ViewData["Title"] = "Marcas"; ViewData["Seccion"] = "Marcas"; }
<section class="encabezado-pagina"><div><p class="sobre-titulo">CATÁLOGOS</p><h1>Marcas</h1><p class="texto-secundario">Registra y organiza las marcas de tus productos.</p></div><a asp-action="Crear" class="boton-principal">＋ Agregar marca</a></section>
@if (TempData["Mensaje"] is string mensaje) { <div class="alert alert-success">@mensaje</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
<section class="panel panel-tabla"><form asp-action="Lista" method="get" class="barra-busqueda"><label for="busqueda">Buscar marca</label><input id="busqueda" name="busqueda" value="@ViewData["Busqueda"]" class="form-control" placeholder="Nombre de la marca" /><button class="boton-secundario" type="submit">Buscar</button><a asp-action="Lista" class="boton-secundario">Limpiar</a></form>
@if (Model.Count == 0) { <div class="estado-vacio"><strong>No hay marcas registradas</strong><small>Agrega una marca para seleccionarla al crear productos.</small></div> }
else { <div class="tabla-responsiva"><table class="tabla-sistema"><thead><tr><th>Marca</th><th>Productos asociados</th><th class="texto-derecha">Acciones</th></tr></thead><tbody>@foreach (var marca in Model) { <tr><td><strong>@marca.nombre_marca</strong></td><td>@marca.Productos.Count</td><td class="texto-derecha"><div class="acciones-tabla"><a asp-action="Editar" asp-route-id="@marca.id_marca" class="accion-enlace">Editar</a><form asp-action="Eliminar" asp-route-id="@marca.id_marca" method="post" onsubmit="return confirm('¿Eliminar esta marca?');"><button type="submit" class="accion-enlace accion-eliminar">Eliminar</button></form></div></td></tr> }</tbody></table></div> }</section>
